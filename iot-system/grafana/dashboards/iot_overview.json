{
  "__inputs": [
    {
      "name": "DS_INFLUXDB",
      "label": "InfluxDB",
      "description": "Select your InfluxDB data source (v2/Flux)",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "influxdb",
      "name": "InfluxDB",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "piechart",
      "name": "Pie chart",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
        {
      "id": 1,
      "title": "🥧 Normal vs Anomaly Distribution (All Sensors)",
      "type": "piechart",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 16
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "targets": [
        {
          "query": "data = from(bucket: \"iot-system\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_readings\")\n  |> filter(fn: (r) => r._field == \"is_anomaly\")\n\nnormal = data\n  |> filter(fn: (r) => r._value == 0)\n  |> count()\n  |> set(key: \"category\", value: \"Normal\")\n\nanomaly = data\n  |> filter(fn: (r) => r._value == 1)\n  |> count()\n  |> set(key: \"category\", value: \"Anomaly\")\n\nunion(tables: [normal, anomaly])\n  |> group(columns: [\"category\"])\n  |> rename(columns: {_value: \"count\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Normal"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#34a853"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Anomaly"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#e6194B"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true
        },
        "pieType": "pie",
        "displayLabels": [
          "name",
          "percent",
          "value"
        ],
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "title": "🌡️ TEMP-001 - Temperature",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 14
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "targets": [
        {
          "query": "from(bucket: \"iot-system\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_readings\")\n  |> filter(fn: (r) => r.sensor_id == \"TEMP-001\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> group(columns: [\"sensor_type\"])",
          "refId": "A",
          "legendFormat": "TEMP-001"
        },
        {
          "query": "from(bucket: \"iot-system\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_readings\")\n  |> filter(fn: (r) => r.sensor_id == \"TEMP-001\")\n  |> filter(fn: (r) => r._field == \"value\" or r._field == \"is_anomaly\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => r.is_anomaly == 1)\n  |> keep(columns: [\"_time\", \"value\"])\n  |> rename(columns: {value: \"_value\"})",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": true,
            "axisLabel": "Temperature (°C)"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "⚠️ Anomaly"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.drawStyle",
                "value": "points"
              },
              {
                "id": "custom.pointSize",
                "value": 5
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.showPoints",
                "value": "always"
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
